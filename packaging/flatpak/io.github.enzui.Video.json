{
  "app-id": "io.github.enzui.Video",
  "branch": "stable",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "video-app",
  "finish-args": [
    "--socket=wayland",
    "--device=dri",
    "--share=network",
    "--socket=pulseaudio",
    "--talk-name=org.freedesktop.secrets",
    "--filesystem=xdg-videos:ro"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "modules": [
    {
      "name": "video",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --locked --offline --release --jobs \"${FLATPAK_BUILDER_N_JOBS:-2}\" --bin video-app",
        "install -Dm755 target/release/video-app /app/bin/video-app",
        "install -Dm644 assets/io.github.enzui.Video.desktop /app/share/applications/io.github.enzui.Video.desktop",
        "install -Dm644 packaging/flatpak/io.github.enzui.Video.metainfo.xml /app/share/metainfo/io.github.enzui.Video.metainfo.xml",
        "install -Dm644 assets/io.github.enzui.Video.svg /app/share/icons/hicolor/scalable/apps/io.github.enzui.Video.svg",
        "install -Dm644 LICENSE /app/share/licenses/io.github.enzui.Video/LICENSE",
        "install -Dm644 vendor/gst-curl/LICENSE-MIT /app/share/licenses/io.github.enzui.Video/gst-curl/LICENSE-MIT",
        "install -Dm644 vendor/gst-curl/UPSTREAM.json /app/share/licenses/io.github.enzui.Video/gst-curl/UPSTREAM.json"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/enz1m/video.git",
          "commit": "@ENZIM_SOURCE_COMMIT@",
          "disable-submodules": true
        },
        {
          "type": "archive",
          "url": "https://github.com/enz1m/video/releases/download/v0.1.3/video-cargo-vendor-0.1.3.tar.xz",
          "sha256": "48b21c31573bd3b729dd1ff63e435f6bb4ff05b7b1ca4a868b643cdbf26cf80e",
          "strip-components": 1
        },
        {
